classDiagram
direction LR

class CrudRepository~T~ {
  <<interface>>
  +create(T) T
  +findById(Long) Optional~T~
  +findAll() List~T~
  +update(T) T
  +deleteById(Long) boolean
  +count() long
}
class FileRepository~T~ {
  <<abstract>>
  #toFields(T)* String[]
  #fromFields(String[])* T
  #headerComment()* String
}
CrudRepository~T~ <|.. FileRepository~T~

